{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledMcpjsonServers": ["apex"],
  "permissions": {
    "allow": [
      "Bash(pnpm build)",
      "Bash(pnpm test)",
      "Bash(pnpm test *)",
      "Bash(pnpm lint)",
      "Bash(pnpm apex *)",
      "Bash(node packages/cli/dist/bin.js *)"
    ],
    "deny": ["Read(./.env)", "Read(./.env.*)", "Read(./private/**)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/lint-on-save.mjs\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
