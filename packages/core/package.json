{
  "name": "@apex-galaxia/core",
  "version": "0.1.0",
  "description": "Apex Galaxia core: project store, Story Bible, chronicle, context assembler, write pipeline, AI-tell linter, narrator profiles. No UI dependencies.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schemas"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "schemas": "node --import tsx ./scripts/write-schemas.ts",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "docx": "^9.13.0",
    "jszip": "^3.10.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  }
}
