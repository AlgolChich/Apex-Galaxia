{
  "$id": "https://apex-galaxia.dev/schemas/guns-found.schema.json",
  "title": "guns-found",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "guns": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "detail": {
            "type": "string",
            "minLength": 1
          },
          "where": {
            "type": "string",
            "minLength": 1
          },
          "payoff": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "default": "medium",
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          }
        },
        "required": [
          "detail",
          "where",
          "payoff"
        ]
      }
    }
  }
}
