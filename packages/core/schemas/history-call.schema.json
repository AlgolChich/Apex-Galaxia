{
  "$id": "https://apex-galaxia.dev/schemas/history-call.schema.json",
  "title": "history-call",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "ts": {
      "type": "string"
    },
    "task": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "prompt_hash": {
      "type": "string"
    },
    "input_tokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "output_tokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "cache_read_tokens": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "cache_write_tokens": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "cost_usd": {
      "type": "number",
      "minimum": 0
    },
    "latency_ms": {
      "type": "number",
      "minimum": 0
    },
    "accepted": {
      "default": null,
      "type": [
        "boolean",
        "null"
      ]
    },
    "suggestion": {
      "type": "string"
    },
    "replay": {
      "default": false,
      "type": "boolean"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "ts",
    "task",
    "provider",
    "model",
    "prompt_hash",
    "input_tokens",
    "output_tokens",
    "cost_usd",
    "latency_ms"
  ]
}
