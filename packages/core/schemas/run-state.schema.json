{
  "$id": "https://apex-galaxia.dev/schemas/run-state.schema.json",
  "title": "run-state",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "started_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "running",
        "awaiting_outline_approval",
        "awaiting_decision",
        "paused",
        "completed",
        "failed"
      ]
    },
    "target_chapters": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "next_chapter": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "stage": {
      "type": "string",
      "enum": [
        "outline",
        "plan",
        "write",
        "chronicle",
        "summary",
        "report",
        "done"
      ]
    },
    "completed": {
      "default": [],
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      }
    },
    "cost_usd": {
      "default": 0,
      "type": "number",
      "minimum": 0
    },
    "outline_approved": {
      "default": false,
      "type": "boolean"
    },
    "pending_suggestion": {
      "type": "string"
    },
    "pending_decision": {
      "type": "object",
      "properties": {
        "chapter": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "who": {
                "type": "string",
                "minLength": 1
              },
              "what": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "who",
              "what"
            ]
          }
        }
      },
      "required": [
        "chapter",
        "items"
      ]
    },
    "approved_decisions": {
      "default": [],
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      }
    },
    "error": {
      "type": "string"
    },
    "log": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "id",
    "started_at",
    "updated_at",
    "status",
    "target_chapters",
    "next_chapter",
    "stage"
  ]
}
