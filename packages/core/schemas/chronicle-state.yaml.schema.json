{
  "$id": "https://apex-galaxia.dev/schemas/chronicle-state.yaml.schema.json",
  "title": "chronicle-state.yaml",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format_version": {
      "default": 1,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "in_story_time": {
      "default": "",
      "type": "string"
    },
    "last_chapter": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "locations": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "condition": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "wounds": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fatigue": {
            "type": "string"
          },
          "mood": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "inventory": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "knowledge": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "fact": {
            "type": "string"
          },
          "known_by": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "since_chapter": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "fact"
        ]
      }
    },
    "relations": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "between": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "trust": {
            "type": "string"
          },
          "promises": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "debts": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "grudges": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "between"
        ]
      }
    },
    "open_threads": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "since_chapter": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "status": {
            "default": "open",
            "type": "string",
            "enum": [
              "open",
              "resolved"
            ]
          }
        },
        "required": [
          "id",
          "text"
        ]
      }
    },
    "planted_guns": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "what": {
            "type": "string"
          },
          "planted_in": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "payoff": {
            "type": "string"
          },
          "fired_in": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "what"
        ]
      }
    },
    "pending_consequences": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "due": {
            "type": "string"
          },
          "done": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "text"
        ]
      }
    },
    "rolls": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "chapter": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "die": {
            "default": "d20",
            "type": "string",
            "const": "d20"
          },
          "result": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "outcome": {
            "type": "string",
            "enum": [
              "luck",
              "lull",
              "trouble",
              "catastrophe"
            ]
          },
          "at": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "chapter",
          "result",
          "outcome"
        ]
      }
    }
  }
}
