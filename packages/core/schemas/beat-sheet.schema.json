{
  "$id": "https://apex-galaxia.dev/schemas/beat-sheet.schema.json",
  "title": "beat-sheet",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "chapter": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "beats": {
      "minItems": 3,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "breather_scene": {
      "type": "string",
      "minLength": 1
    },
    "ending_image": {
      "type": "string",
      "minLength": 1
    },
    "world_tick": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "guns": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cliffhanger": {
      "type": "string"
    }
  },
  "required": [
    "chapter",
    "title",
    "goal",
    "beats",
    "breather_scene",
    "ending_image"
  ]
}
