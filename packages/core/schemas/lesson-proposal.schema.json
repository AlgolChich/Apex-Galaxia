{
  "$id": "https://apex-galaxia.dev/schemas/lesson-proposal.schema.json",
  "title": "lesson-proposal",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "category": {
      "type": "string",
      "enum": [
        "dialogue",
        "exposition",
        "cliche",
        "rhythm",
        "labeling",
        "pacing",
        "continuity",
        "voice",
        "sensory",
        "other"
      ]
    },
    "rule": {
      "type": "string"
    },
    "before": {
      "type": "string"
    },
    "after": {
      "type": "string"
    },
    "language": {
      "default": "both",
      "type": "string",
      "enum": [
        "ru",
        "en",
        "both"
      ]
    }
  },
  "required": [
    "category",
    "rule"
  ]
}
