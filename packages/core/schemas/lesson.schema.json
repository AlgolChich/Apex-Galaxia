{
  "$id": "https://apex-galaxia.dev/schemas/lesson.schema.json",
  "title": "lesson",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "date": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "dialogue",
        "exposition",
        "cliche",
        "rhythm",
        "labeling",
        "pacing",
        "continuity",
        "voice",
        "sensory",
        "other"
      ]
    },
    "rule": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "default": "",
      "type": "string"
    },
    "before": {
      "type": "string"
    },
    "after": {
      "type": "string"
    },
    "weight": {
      "default": 1,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "language": {
      "default": "both",
      "type": "string",
      "enum": [
        "ru",
        "en",
        "both"
      ]
    }
  },
  "required": [
    "id",
    "date",
    "category",
    "rule"
  ]
}
